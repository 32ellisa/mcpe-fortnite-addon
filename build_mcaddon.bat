@echo off\nREM Batch script to build the MCPE add-on into a .mcaddon file\nREM This script uses PowerShell to create a ZIP file\n\nsetlocal enabledelayedexpansion\n\nREM Set paths\nset OUTPUT=fortnite-inspired-battle-royale.mcaddon\nset BEHAVIOR=behavior_pack\nset RESOURCE=resource_pack\n\nREM Check if behavior_pack and resource_pack exist\nif not exist \"%BEHAVIOR%\" (\n    echo Error: behavior_pack folder not found\n    pause\n    exit /b 1\n)\n\nif not exist \"%RESOURCE%\" (\n    echo Error: resource_pack folder not found\n    pause\n    exit /b 1\n)\n\nREM Remove old .mcaddon file if it exists\nif exist \"%OUTPUT%\" (\n    del \"%OUTPUT%\"\n)\n\nREM Create the .mcaddon file using PowerShell\necho Creating %OUTPUT%...\n\npowershell -Command \"Add-Type -AssemblyName 'System.IO.Compression.FileSystem'; [System.IO.Compression.ZipFile]::CreateFromDirectory('%cd%\\behavior_pack', '%cd%\\temp_behavior.zip'); [System.IO.Compression.ZipFile]::CreateFromDirectory('%cd%\\resource_pack', '%cd%\\temp_resource.zip')\"\n\nif exist \"temp_behavior.zip\" (\n    ren temp_behavior.zip temp_behavior\n    type temp_behavior >> \"%OUTPUT%\"\n    del temp_behavior\n)\n\nif exist \"temp_resource.zip\" (\n    ren temp_resource.zip temp_resource\n    type temp_resource >> \"%OUTPUT%\"\n    del temp_resource\n)\n\nREM Alternative method: Use built-in Windows compression (requires 7-Zip or WinRAR installed)\nREM If the above doesn't work, you may need to use:\nREM powershell -NoProfile -Command \"[System.IO.Compression.ZipFile]::CreateFromDirectory('%cd%\\behavior_pack', '%cd%\\%OUTPUT%')\"\n\necho.\necho %OUTPUT% created successfully!\necho Import this file into Minecraft Bedrock:\necho 1. Open Minecraft Bedrock\necho 2. Go to Settings ^> Global Resources\necho 3. Import the %OUTPUT% file\necho.\npause\n