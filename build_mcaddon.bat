@echo off\nREM Batch script to build the MCPE add-on into a .mcaddon file\nREM This uses PowerShell to create the ZIP file\n\nsetlocal enabledelayedexpansion\n\nREM Set paths\nset OUTPUT=fortnite-inspired-battle-royale.mcaddon\nset BEHAVIOR=behavior_pack\nset RESOURCE=resource_pack\n\nREM Check if behavior_pack and resource_pack exist\nif not exist \"%BEHAVIOR%\" (\n    echo Error: behavior_pack folder not found\n    pause\n    exit /b 1\n)\n\nif not exist \"%RESOURCE%\" (\n    echo Error: resource_pack folder not found\n    pause\n    exit /b 1\n)\n\nREM Remove old .mcaddon file if it exists\nif exist \"%OUTPUT%\" (\n    del \"%OUTPUT%\"\n)\n\necho Creating %OUTPUT%...\n\nREM Use PowerShell to create a ZIP file with both folders\npowershell -NoProfile -Command \"$ProgressPreference = 'SilentlyContinue'; Add-Type -AssemblyName 'System.IO.Compression.FileSystem'; $zip = [System.IO.Compression.ZipFile]::Open('%CD%\\%OUTPUT%', 'Create'); [System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, '%CD%\\behavior_pack', 'behavior_pack'); [System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, '%CD%\\resource_pack', 'resource_pack'); $zip.Dispose()\"\n\nif errorlevel 1 (\n    echo.\n    echo Error: Failed to create %OUTPUT%\n    echo Make sure behavior_pack and resource_pack folders exist in this directory.\n    pause\n    exit /b 1\n)\n\nif exist \"%OUTPUT%\" (\n    echo.\n    echo SUCCESS! %OUTPUT% created successfully!\n    echo.\n    echo Next steps:\n    echo 1. Copy %OUTPUT% to your Minecraft device\n    echo 2. Open Minecraft Bedrock\n    echo 3. Go to Settings ^> Global Resources\n    echo 4. Import the %OUTPUT% file\n    echo 5. Create a new world and enable the add-on\n    echo.\n) else (\n    echo.\n    echo Error: %OUTPUT% was not created\n    echo.\n)\n\npause\n